# 复制为 .env 后按需修改
# ---------- 服务 ----------
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ---------- 存储 ----------
DATA_DIR=data
DB_PATH=data/mail.db
EML_DIR=data/eml
# 对称加密密钥文件（首次启动自动生成，请勿泄露/提交到仓库）
SECRET_KEY_FILE=data/.secret_key

# ---------- 同步 ----------
# 定时同步间隔（秒），默认 30 秒；设为 0 关闭定时任务。
# 收件箱与垃圾邮件都会自动同步。注意：间隔过短（如 <10 秒）可能触发服务商 IMAP 风控
SYNC_INTERVAL_SECONDS=30
# 首次同步回看天数
INITIAL_SYNC_DAYS=30
# 单批拉取数量
FETCH_BATCH_SIZE=200
# 单封邮件落盘 .eml 的大小上限（字节），超过则只存元数据
MAX_EML_BYTES=20971520

# ---------- 通知（P4+，默认关闭）----------
NOTIFY_ENABLED=false

# ---------- OAuth2（P5：Gmail API / Microsoft Graph）----------
# 前端可访问的服务地址；OAuth 回调地址 = {该值}/api/oauth/{provider}/callback
# 必须与 OAuth 应用中登记的重定向 URI 完全一致（host/port/协议都要一致）
APP_PUBLIC_BASE_URL=http://127.0.0.1:8000

# ---------- 摘要 / LLM（P4，可选）----------
# 关闭时仅用规则摘要，系统完整可用；也可在界面「摘要设置」里配置（界面配置优先）
LLM_ENABLED=false
# openai = OpenAI / 兼容接口（含代理）；ollama = 本地 Ollama
LLM_PROVIDER=openai
# 留空按 provider 取默认：openai→https://api.openai.com/v1；ollama→http://localhost:11434/v1
LLM_BASE_URL=
# OpenAI / 兼容接口的 API Key（加密存储，勿提交到仓库）；本地 Ollama 可留空
LLM_API_KEY=
# 留空按 provider 取默认：gpt-4o-mini / llama3.1
LLM_MODEL=
# 送入 LLM 的正文截断字数
LLM_MAX_CHARS=4000
# LLM 请求超时（秒）
LLM_TIMEOUT=30